{
  "expo": {
    "name": "MedVerify",
    "slug": "MedVerify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medverify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koetech.medverify",
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow MedVerify to access your camera to scan medicine packaging, barcodes, and QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow MedVerify to access your photo library to select a profile photo.",
        "NSLocationWhenInUseUsageDescription": "Allow MedVerify to access your location to find nearby pharmacies and pharmacists."
      }
    },
    "android": {
      "package": "com.vwindi.medverify",
      "adaptiveIcon": {
        "backgroundColor": "#0B1C5A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#00000000",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1C5A",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedVerify to access your camera to scan medicine packaging, barcodes, and QR codes."
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0B1C5A",
          "sounds": []
        }
      ],
      "react-native-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6babbcbf-b709-4e16-b9ea-ebe8b0cbffe2"
      }
    },
    "owner": "koetech"
  }
}
