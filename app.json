{
  "expo": {
    "name": "MedVerify",
    "slug": "MedVerify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medverify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vwindi.medverify",
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio", "voip"],
        "NSCameraUsageDescription": "Allow MedVerify to access your camera for video consultations.",
        "NSMicrophoneUsageDescription": "Allow MedVerify to access your microphone for audio consultations.",
        "NSLocationWhenInUseUsageDescription": "Allow MedVerify to access your location to find nearby pharmacies.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow MedVerify to access your location to find nearby pharmacies."
      }
    },
    "android": {
      "package": "com.vwindi.medverify",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#00000000",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow MedVerify to access your camera for video consultations.",
          "microphonePermission": "Allow MedVerify to access your microphone for audio consultations."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedVerify to access your camera for video consultations and scanner functions."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MedVerify to access your location to find nearby pharmacies."
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0B1C5A",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acc68557-7acf-424f-b2eb-8dd2f4f02641"
      }
    },
    "owner": "vwindi"
  }
}
