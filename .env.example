# Base URL of the MedVerify backend API (REST + Socket.io share this URL).
# Production (Render): https://med-verify-backend.onrender.com
# Local dev (web):     http://localhost:4000
# Local dev (device):  http://<your-LAN-IP>:4000
EXPO_PUBLIC_API_URL=

# Google OAuth client IDs for "Sign in with Google" (users only).
# Create all three types in Google Cloud Console under the same project.
# Web:     used on Expo web and as the audience validator on the backend
# Android: package name com.vwindi.medverify + SHA-1 fingerprint
# iOS:     bundle ID com.vwindi.medverify
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=yyyy.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=zzzz.apps.googleusercontent.com
