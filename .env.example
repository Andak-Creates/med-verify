# Base URL of the MedVerify backend API (REST + Socket.io share this URL).
# Production (Render): https://med-verify-backend.onrender.com
# Local dev (web):     http://localhost:4000
# Local dev (device):  http://<your-LAN-IP>:4000
EXPO_PUBLIC_API_URL=

# Google OAuth client ID used for "Sign in with Google" (users only).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
