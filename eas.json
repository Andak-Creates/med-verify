{
  "cli": {
    "version": ">= 20.0.0",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://med-verify-backend.onrender.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "876887187989-jpt3543i72ok3rlc4dtmbiv0vrcj06tm.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://med-verify-backend.onrender.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "876887187989-jpt3543i72ok3rlc4dtmbiv0vrcj06tm.apps.googleusercontent.com"
      }
    },
    "production": {
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://med-verify-backend.onrender.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "876887187989-jpt3543i72ok3rlc4dtmbiv0vrcj06tm.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
